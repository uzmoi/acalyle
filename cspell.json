{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "dictionaries": ["custom-words"],
  "useGitignore": true,
  "ignorePaths": [
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    ".git",
    "*.icns",
    "biome.json",
    "patches/"
  ],
  "enableGlobDot": true,
  "dictionaryDefinitions": [
    {
      "name": "custom-words",
      "path": "./cspell-custom-words.txt"
    }
  ]
}
