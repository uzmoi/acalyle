{
  "compilerOptions": {
    "target": "ESNext",
    "moduleResolution": "bundler",
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true,
    "allowJs": false,
    "noEmit": true,

    "lib": ["ESNext"],
    "libReplacement": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    "plugins": [{ "name": "eslint-plugin-import-access" }],
  },
}
