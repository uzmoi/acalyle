// cspell:ignore nonoctal isnan nonconstructor

{
  "$schema": "node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [
    "**/{dist,coverage,__generated__,storybook-static}/**",
    "**/__*",
    "**/*.ignore.*",
    "**/*.ignore/**",
    "**/*.log",
    "**/*.d.ts",
    "**/*.d.*.ts",
    "**/*.js",
    "apps/tauri/**",
  ],
  "env": {
    "builtin": true,
  },
  "plugins": ["unicorn", "typescript", "import", "react"],
  "categories": {
    "correctness": "error",
    "restriction": "error",
    "suspicious": "warn",
    "pedantic": "warn",
    "style": "warn",
  },
  "options": {
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "warn",
    "typeAware": true,
    "typeCheck": true,
  },
  "rules": {
    // Correctness (default: error)
    "eslint/no-empty-pattern": "warn",
    "eslint/no-empty-static-block": "warn",
    "eslint/no-extra-boolean-cast": "warn",
    "eslint/no-irregular-whitespace": "warn",
    "eslint/no-unsafe-negation": [
      "error",
      { "enforceForOrderingRelations": true },
    ],
    "eslint/no-unused-labels": "warn",
    "eslint/no-unused-private-class-members": "warn",
    "eslint/no-unused-vars": "warn",
    "eslint/no-useless-catch": "warn",
    "eslint/no-useless-rename": "warn",
    "eslint/require-yield": "off",
    "typescript/no-extra-non-null-assertion": "warn",
    "typescript/no-this-alias": "warn",
    "typescript/prefer-as-const": "warn",
    "unicorn/no-empty-file": "warn",
    "unicorn/no-single-promise-in-promise-methods": "warn",
    "unicorn/no-thenable": "off",
    "unicorn/no-unnecessary-await": "warn",
    "unicorn/no-useless-fallback-in-spread": "warn",
    "unicorn/no-useless-length-check": "warn",
    "unicorn/no-useless-spread": "warn",
    "unicorn/prefer-set-size": "warn",
    "unicorn/prefer-string-starts-ends-with": "warn",

    // Restriction (default: error)
    "eslint/default-case": ["error", { "commentPattern": "^no default:" }],
    "eslint/no-bitwise": "off",
    "eslint/no-console": "warn",
    "eslint/no-div-regex": "warn",
    "eslint/no-empty": "warn",
    "eslint/no-eq-null": "off",
    "eslint/no-param-reassign": "off",
    "eslint/no-plusplus": "off",
    "eslint/no-regex-spaces": "warn",
    // prettier-ignore
    "eslint/no-restricted-globals": [
      "error",
      // 使うことが全く無いのにグローバルに存在して名前が単純なせいで間違えて使っても気づきにくい名前
      "name", "length", "toString", "print",
      "event", "status", "parent", "origin", "screen",
      "open", "opener", "close", "closed", "focus", "blur",
      "top", "stop", "external", "Plugin", "PluginArray",
    ],
    "eslint/no-undefined": "off",
    "eslint/no-unused-expressions": ["warn", { "enforceForJSX": true }],
    "eslint/no-void": "off",
    "typescript/explicit-function-return-type": [
      "warn",
      { "allowExpressions": true },
    ],
    "typescript/explicit-member-accessibility": "off",
    "typescript/no-empty-object-type": "off",
    "typescript/no-namespace": [
      "error",
      { "allowDeclarations": true, "allowDefinitionFiles": true },
    ],
    "typescript/no-non-null-assertion": "off",
    "typescript/promise-function-async": "off",
    "unicorn/no-array-reduce": "off",
    "unicorn/no-length-as-slice-end": "warn",
    "unicorn/no-nested-ternary": "off",
    "unicorn/no-process-exit": "off",
    "unicorn/prefer-modern-math-apis": "warn",
    "unicorn/prefer-number-properties": ["warn", { "checkInfinity": false }],

    // Suspicious (default: warn)
    "eslint/no-extend-native": "error",
    "eslint/no-shadow": "off",
    "eslint/no-underscore-dangle": ["warn", { "allowAfterThis": true }],
    "typescript/consistent-return": "off",
    "typescript/no-unnecessary-type-parameters": "off",
    "typescript/no-unsafe-type-assertion": "off",
    "unicorn/require-module-specifiers": "off",

    // Pedantic (default: warn)
    "eslint/array-callback-return": "off",
    "eslint/eqeqeq": ["error", "always", { "null": "ignore" }],
    "eslint/max-classes-per-file": "off",
    "eslint/max-depth": ["warn", { "max": 4 }],
    "eslint/max-lines": ["warn", { "max": 512 }],
    "eslint/max-lines-per-function": ["warn", { "max": 256 }],
    "eslint/max-nested-callbacks": ["warn", { "max": 3 }],
    "eslint/no-case-declarations": "error",
    "eslint/no-else-return": "off",
    "eslint/no-fallthrough": "error",
    "eslint/no-inline-comments": "off",
    "eslint/no-redeclare": "off",
    "eslint/no-warning-comments": "off",
    "eslint/require-await": "off",
    "eslint/require-unicode-regexp": "off",
    "typescript/ban-ts-comment": "error",
    "typescript/ban-types": "off",
    "typescript/no-unsafe-function-type": "error",
    "typescript/prefer-readonly-parameter-types": "off",
    "typescript/prefer-ts-expect-error": "error",
    "typescript/strict-boolean-expressions": "off",
    "unicorn/no-array-callback-reference": "off",
    "unicorn/no-useless-promise-resolve-reject": "off",
    "unicorn/prefer-code-point": "off",
    "unicorn/prefer-math-trunc": "off",
    "unicorn/prefer-native-coercion-functions": "off",
    "unicorn/prefer-query-selector": "off",

    // Style (default: warn)
    "eslint/arrow-body-style": "off",
    "eslint/capitalized-comments": "off",
    "eslint/curly": "off",
    "eslint/func-names": ["warn", "as-needed"],
    "eslint/id-length": "off",
    "eslint/init-declarations": "off",
    "eslint/max-params": ["warn", { "max": 4 }],
    "eslint/max-statements": "off",
    "eslint/new-cap": "off",
    "eslint/no-continue": "off",
    "eslint/no-implicit-coercion": "off",
    "eslint/no-labels": "off",
    "eslint/no-magic-numbers": [
      "warn",
      {
        "ignore": [-1, 0, 1],
        "ignoreArrayIndexes": true,
        "ignoreDefaultValues": true,
        "ignoreClassFieldInitialValues": true,
        "ignoreReadonlyClassProperties": true,
        "ignoreEnums": true,
        "ignoreNumericLiteralTypes": true,
        "ignoreTypeIndexes": true,
      },
    ],
    "eslint/no-multi-str": "off",
    "eslint/no-nested-ternary": "off",
    "eslint/no-ternary": "off",
    "eslint/one-var": "off",
    "eslint/prefer-named-capture-group": "off",
    "eslint/sort-keys": "off",
    "eslint/vars-on-top": "off",
    "eslint/yoda": ["warn", "never", { "exceptRange": true }],
    "typescript/adjacent-overload-signatures": "error",
    "typescript/consistent-indexed-object-style": "off",
    "typescript/consistent-type-definitions": "off",
    "typescript/method-signature-style": "off",
    "typescript/no-empty-interface": "off",
    "typescript/parameter-properties": "off",
    "unicorn/max-nested-calls": "off",
    "unicorn/no-null": "off",
    "unicorn/number-literal-case": "off",
    "unicorn/numeric-separators-style": [
      "warn",
      { "hexadecimal": { "groupLength": 4 } },
    ],
    "unicorn/prefer-reflect-apply": "off",
    "unicorn/prefer-string-raw": "off",

    // import/export
    "eslint/sort-imports": ["warn", { "ignoreDeclarationSort": true }],
    "import/consistent-type-specifier-style": "off",
    "import/export": "error",
    "import/exports-last": "off",
    "import/group-exports": "off",
    "import/max-dependencies": ["warn", { "max": 24 }],
    "import/named": "error",
    "import/no-absolute-path": "error",
    "import/no-cycle": ["warn", { "maxDepth": 64, "ignoreExternal": true }],
    "import/no-default-export": "warn",
    "import/no-duplicates": ["warn", { "preferInline": true }],
    "import/no-mutable-exports": "error",
    "import/no-named-as-default-member": "error",
    "import/no-named-export": "off",
    "import/no-namespace": "off",
    "import/no-relative-parent-imports": "off",
    "import/no-unassigned-import": "off",
    "import/prefer-default-export": "off",
    "unicorn/import-style": "off",

    // react
    "react/exhaustive-deps": "error",
    "react/forbid-component-props": "off",
    "react/function-component-definition": "off",
    "react/iframe-missing-sandbox": "error",
    "react/jsx-filename-extension": ["error", { "extensions": [".tsx"] }],
    "react/jsx-max-depth": "off",
    "react/jsx-no-comment-textnodes": "off",
    "react/jsx-no-literals": "off",
    "react/jsx-no-script-url": "error",
    "react/jsx-props-no-spreading": "off",
    "react/no-danger": "off",
    "react/no-namespace": "error",
    "react/no-set-state": "off",
    "react/no-unescaped-entities": "error",
    "react/no-unstable-nested-components": ["warn", { "allowAsProps": true }],
    "react/react-in-jsx-scope": "off",
    "react/rules-of-hooks": "error",
  },
  "overrides": [
    {
      "files": ["**/*.{config,stories}.*", "**/.storybook/**"],
      "rules": {
        "no-anonymous-default-export": "off",
        "no-default-export": "off",
      },
    },
    {
      "files": [
        "**/*.{config,stories,dev}.*",
        "**/.storybook/**",
        "**/dev/**",
        "**/*.test.*",
      ],
      "rules": {
        "eslint/max-depth": "off",
        "eslint/max-lines": "off",
        "eslint/max-lines-per-function": "off",
        "eslint/max-nested-callbacks": "off",
        "eslint/no-magic-numbers": "off",
        "eslint/no-use-before-define": "off",
        "import/no-nodejs-modules": "off",
        "react/only-export-components": "off",
      },
    },
    {
      "files": ["apps/client/src/app/routes/**"],
      "rules": {
        "eslint/no-use-before-define": "off",
        "react/only-export-components": "off",
        "unicorn/filename-case": "off",
      },
    },
  ],
}
